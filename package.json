{
  "name": "dsh-session-continuity",
  "version": "0.2.3",
  "description": "新会话开始时注入一条很小的接续指针，指向上一个会话与工作区交接文档；没有文档时补上那个会话的最后两句。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "session",
    "context",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymck-x/dsh-session-continuity.git"
  },
  "bugs": {
    "url": "https://github.com/ymck-x/dsh-session-continuity/issues"
  },
  "homepage": "https://github.com/ymck-x/dsh-session-continuity#readme",
  "license": "MIT"
}
